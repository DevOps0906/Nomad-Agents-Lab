{
  "name": "nomad-ssr-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "SSR+ 데스크톱 앱 (Electron)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "oxlint --deny-warnings src tests scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fuses:read": "electron-fuses read --app dist/win-unpacked/SSR.exe",
    "package": "electron-vite build && electron-builder --win dir",
    "smoke": "electron scripts/smoke.cjs"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.2",
    "better-sqlite3": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
